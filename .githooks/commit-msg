#!/usr/bin/env bash
#
# Commit message hook for Tapestry
# Validates commit messages follow Conventional Commits format
#
# Format: <type>(<scope>): <description>
# Example: feat(rfd): add create command
#
# To install: Run `git config core.hooksPath .githooks` in the repository root
#

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Skip merge commits
if echo "$commit_msg" | grep -qE "^Merge"; then
    exit 0
fi

# Skip commits from Claude Code (co-authored)
if echo "$commit_msg" | grep -qE "Co-Authored-By: Claude"; then
    exit 0
fi

# Conventional Commits pattern
# Type: feat, fix, docs, style, refactor, perf, test, chore, ci, build
# Scope: optional, e.g., (rfd), (git-workflow)
# Breaking change: optional !
pattern='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build)(\([a-z0-9-]+\))?!?: .{1,100}'

if ! echo "$commit_msg" | head -n 1 | grep -qE "$pattern"; then
    echo -e "${RED}Invalid commit message format!${NC}" >&2
    echo "" >&2
    echo "Commit message must follow Conventional Commits format:" >&2
    echo -e "${YELLOW}<type>(<scope>): <description>${NC}" >&2
    echo "" >&2
    echo "Types: feat, fix, docs, style, refactor, perf, test, chore, ci, build" >&2
    echo "Scope: optional, e.g., rfd, git-workflow" >&2
    echo "" >&2
    echo "Examples:" >&2
    echo "  feat(rfd): add create command" >&2
    echo "  fix(rfd): handle missing config file" >&2
    echo "  docs: update README with installation instructions" >&2
    echo "  chore: update dependencies" >&2
    echo "" >&2
    echo "Your commit message:" >&2
    echo -e "${YELLOW}$commit_msg${NC}" >&2
    exit 1
fi

exit 0

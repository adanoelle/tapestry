#!/bin/bash
#
# Pre-commit hook for Tapestry
# Runs formatting, linting, and tests before allowing commit
#
# To install: Run `git config core.hooksPath .githooks` in the repository root
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Check if cargo is available
if ! command -v cargo &> /dev/null; then
    echo -e "${RED}Error: cargo not found. Please install Rust.${NC}"
    exit 1
fi

# 1. Format check
echo -e "\n${YELLOW}[1/4] Checking code formatting...${NC}"
if ! cargo fmt --all -- --check; then
    echo -e "${RED}Formatting check failed!${NC}"
    echo -e "${YELLOW}Run 'cargo fmt --all' to fix formatting issues.${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Formatting check passed${NC}"

# 2. Clippy (linting)
echo -e "\n${YELLOW}[2/4] Running clippy...${NC}"
if ! cargo clippy --workspace --all-targets --all-features -- -D warnings; then
    echo -e "${RED}Clippy found issues!${NC}"
    echo -e "${YELLOW}Please fix the warnings above.${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Clippy passed${NC}"

# 3. Tests
echo -e "\n${YELLOW}[3/4] Running tests...${NC}"
if ! cargo test --workspace --all-features; then
    echo -e "${RED}Tests failed!${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Tests passed${NC}"

# 4. Check for common issues
echo -e "\n${YELLOW}[4/4] Checking for common issues...${NC}"

# Check for debug prints (println!, dbg!)
if git diff --cached --name-only | grep -E '\.rs$' | xargs grep -n "println!\|dbg!" 2>/dev/null; then
    echo -e "${YELLOW}Warning: Found debug prints (println! or dbg!) in staged files.${NC}"
    echo -e "${YELLOW}Consider removing them or using proper logging.${NC}"
    read -p "Continue anyway? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi

# Check for TODO/FIXME comments in staged files
if git diff --cached --name-only | grep -E '\.rs$' | xargs grep -n "TODO\|FIXME" 2>/dev/null; then
    echo -e "${YELLOW}Note: Found TODO/FIXME comments in staged files.${NC}"
fi

echo -e "\n${GREEN}✓ All checks passed!${NC}"
echo -e "${GREEN}Proceeding with commit...${NC}"
